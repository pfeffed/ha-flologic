  "issues": {
    "unofficial_entry": {
      "title": "FloLogic entry from the unofficial integration",
      "description": "The entry \"{title}\" was created by the unofficial FloLogic integration, which has moved to the `flologic_unofficial` domain. This integration uses FloLogic's official Web API and cannot use that entry's email and password.\n\nDelete the entry under Settings > Devices & services, then add **FloLogic (Unofficial)** to keep the app-protocol integration, **FloLogic** to use the official API, or both."
    }
  }
