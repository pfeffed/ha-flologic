{
  "config": {
    "step": {
      "user": {
        "title": "Connect to FloLogic",
        "description": "Enter the API credentials FloLogic issued you. Every valve they can see is added, so one entry covers all of them.",
        "data": {
          "api_key": "API key",
          "company_id": "Company ID",
          "webhook_secret": "Webhook signing secret"
        },
        "data_description": {
          "api_key": "Your FloLogic Web API key. It is stored locally and sent only to FloLogic.",
          "company_id": "The company ID issued with the key. FloLogic needs both.",
          "webhook_secret": "Optional. From Dashboard > API Manager. Needed to receive callbacks, which update Home Assistant within seconds instead of on the next poll."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate FloLogic",
        "description": "FloLogic rejected the saved API key for company {company_id}. Enter a new one.",
        "data": {
          "api_key": "API key"
        }
      },
      "reconfigure": {
        "title": "Update FloLogic credentials",
        "description": "Replace the API key or the webhook signing secret for company {company_id}. Leave a field empty to keep its current value.",
        "data": {
          "api_key": "API key",
          "webhook_secret": "Webhook signing secret"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach FloLogic. Check your internet connection and try again.",
      "invalid_auth": "FloLogic rejected that API key or company ID.",
      "unknown": "Unexpected error talking to FloLogic."
    },
    "abort": {
      "already_configured": "This FloLogic company is already set up.",
      "reauth_successful": "FloLogic re-authenticated successfully.",
      "reconfigure_successful": "FloLogic credentials updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "FloLogic options",
        "description": "FloLogic's Web API has no push channel of its own. Without callbacks, Home Assistant learns of changes only when it polls.",
        "data": {
          "poll_interval": "Polling interval",
          "use_callbacks": "Receive callbacks"
        },
        "data_description": {
          "poll_interval": "Seconds between polls. FloLogic documents no rate limit, so the minimum is conservative.",
          "use_callbacks": "Register a callback with FloLogic so changes arrive within seconds. Needs the webhook signing secret, and either Home Assistant Cloud or an external URL FloLogic can reach."
        }
      }
    },
    "error": {
      "secret_required": "Add the webhook signing secret first (Reconfigure on the integration's menu). Unsigned callbacks are not accepted.",
      "no_url": "FloLogic cannot reach this Home Assistant. Sign in to Home Assistant Cloud, or set an external URL under Settings > System > Network."
    }
  },
